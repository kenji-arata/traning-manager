generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BodyPart {
  ARM       
  SHOULDER  
  CHEST     
  LEG       
  BACK      
  ABS       
}

model BodyPartMaster {
  id                        Int                      @id @default(autoincrement())
  name                      String                   @unique
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  trainingItems             TrainingItem[]
  trainingItemBodyParts     TrainingItemBodyPart[]

  @@map("body_parts")
}

model TrainingItem {
  id                      Int                      @id @default(autoincrement())
  name                    String
  bodyPartMasterId        Int                      @map("body_part_master_id")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  bodyPartMaster          BodyPartMaster           @relation(fields: [bodyPartMasterId], references: [id])
  trainingRecords         TrainingRecord[]
  trainingRecordTemplates TrainingRecordTemplate[]
  trainingItemBodyParts   TrainingItemBodyPart[]

  @@map("training_items")
}

model TrainingItemBodyPart {
  id             Int              @id @default(autoincrement())
  trainingItemId Int              @map("training_item_id")
  bodyPartId     Int              @map("body_part_id")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  trainingItem   TrainingItem     @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)
  bodyPart       BodyPartMaster   @relation(fields: [bodyPartId], references: [id])

  @@unique([trainingItemId, bodyPartId])
  @@map("training_item_body_parts")
}

model TrainingRecord {
  id             Int          @id @default(autoincrement())
  date           DateTime
  trainingItemId Int          @map("training_item_id")
  weight         Float
  repetitions    Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)

  @@map("training_records")
}

model TrainingTemplate {
  id                       Int                       @id @default(autoincrement())
  name                     String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  trainingRecordTemplates  TrainingRecordTemplate[]

  @@map("training_templates")
}

model TrainingRecordTemplate {
  id                 Int              @id @default(autoincrement())
  trainingTemplateId Int              @map("training_template_id")
  trainingItemId     Int              @map("training_item_id")
  weight             Float?
  repetitions        Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  trainingTemplate   TrainingTemplate @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)
  trainingItem       TrainingItem     @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)

  @@map("training_record_templates")
}