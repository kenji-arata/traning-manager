generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BodyPart {
  ARM       
  SHOULDER  
  CHEST     
  LEG       
  BACK      
  ABS       
}

model TrainingItem {
  id                      Int                      @id @default(autoincrement())
  name                    String
  bodyPart                BodyPart
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  trainingRecords         TrainingRecord[]
  trainingRecordTemplates TrainingRecordTemplate[]

  @@map("training_items")
}

model TrainingRecord {
  id             Int          @id @default(autoincrement())
  date           DateTime
  trainingItemId Int          @map("training_item_id")
  weight         Float
  repetitions    Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)

  @@map("training_records")
}

model TrainingTemplate {
  id                       Int                       @id @default(autoincrement())
  name                     String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  trainingRecordTemplates  TrainingRecordTemplate[]

  @@map("training_templates")
}

model TrainingRecordTemplate {
  id                 Int              @id @default(autoincrement())
  trainingTemplateId Int              @map("training_template_id")
  trainingItemId     Int              @map("training_item_id")
  weight             Float?
  repetitions        Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  trainingTemplate   TrainingTemplate @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)
  trainingItem       TrainingItem     @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)

  @@map("training_record_templates")
}